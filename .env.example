NEO4J_URI=neo4j://localhost
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

GROQ_API_KEY=fdfafdsffds
GROQ_LLM_API_KEY=fadfdsfafsfda
LLM_API_KEY=fdafdfdfda

MODEL="llama-3.1-8b-instant"

GLOBAL_OPERATIONAL_THRESHOLD=5

# Optional overrides — each already has a working default in code/config.yml
# (paths.* / alerts.*). Only set these if you need a non-default location or
# a different MCP HTTP port.
ALERTS_DB=data/processed/sankalp_alerts.db
ARMY_GOLD_DB=data/processed/sankalp_army_gold.db
AUTOMATION_DB=data/processed/sankalp_automation.db
IAF_GOLD_DB=data/processed/sankalp_gold.db
NAVY_GOLD_DB=data/processed/sankalp_navy_gold.db
MCP_PORT=8080
MONITOR_POLL_SECS=60